{
  "name": "saas-core",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-Tenant Enterprise B2B SaaS Orchestrator & Ultra-Premium Design System",
  "workspaces": [
    "client",
    "server",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "dev:all": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "lint": "eslint \"client/src/**/*.{ts,tsx}\" \"server/src/**/*.ts\"",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "test": "npm run test --workspace=server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vercel/node": "^22.0.0",
    "concurrently": "^9.1.2",
    "eslint": "^10.13.0",
    "typescript-eslint": "^8.72.0"
  }
}
